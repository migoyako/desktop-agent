# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Local secrets
config/keys.json
config/mcp_keys.json

# Local companion data (persona packs are project assets and stay tracked)
data/*
!data/personas/
!data/personas/**
data/personas/_backups/

# Character art is user-supplied and licensed elsewhere: track the slot
# documentation only, never the files dropped into it.
!data/assets/
data/assets/*
!data/assets/README.md
!data/assets/*/
data/assets/*/*
!data/assets/*/README.md

# Tooling
.pytest_cache/
.mypy_cache/
.idea/
.vscode/

# Local design and diagnostic scratch output. Tracked board generators remain
# available, but their generated HTML, screenshots, and logs do not.
.tmp-s4/
.tmp-pixso/*.log
.tmp-pixso/*-measure.html
.tmp-pixso/shots/

# Reference projects
/research/

# Accidental shell artifacts
/$null

# Local backups
backups/
